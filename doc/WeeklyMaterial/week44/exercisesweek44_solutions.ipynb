    "print(\"wrapper = week-41 loop on the last 2000:\", f\"{clf0.score(X_sub[8000:], y_sub[8000:]):.4f}\", f\"{accuracy(X_sub[8000:], y_sub[8000:], layers_c, 'relu', 'softmax'):.4f}\")"
