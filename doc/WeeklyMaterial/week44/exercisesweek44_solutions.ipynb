    "def heat(ax, M, title, within=None, best=None, one=None, fmt=\"{:.3f}\"):\n",
    "    im = ax.imshow(M, cmap=\"viridis_r\", origin=\"lower\")\n",
    "    ax.set_xticks(range(M.shape[1])); ax.set_xticklabels([f\"{v:g}\" for v in lambdas], fontsize=8)\n",
    "    ax.set_yticks(range(M.shape[0])); ax.set_yticklabels([f\"{v:g}\" for v in gammas], fontsize=8)\n",
    "    ax.set_xlabel(\"$\\\\lambda$\"); ax.set_ylabel(\"$\\\\gamma$\"); ax.set_title(title, fontsize=9)\n",
    "    for i in range(M.shape[0]):\n",
    "        for j in range(M.shape[1]):\n",
    "            ax.text(j, i, fmt.format(M[i, j]), ha=\"center\", va=\"center\", fontsize=7,\n",
    "                    color=\"white\" if M[i, j] > 0.6 * M.max() else \"black\",\n",
    "                    fontweight=\"bold\" if within is not None and within[i, j] else \"normal\")\n",
    "    if best is not None:\n",
    "        ax.plot(best[1], best[0], \"s\", mfc=\"none\", mec=RED, mew=2, ms=18)\n",
    "    if one is not None:\n",
    "        ax.plot(one[1], one[0], \"o\", mfc=\"none\", mec=YELLOW, mew=2, ms=18)\n",
    "    return im\n",
    "\n",
    "\n",
    "fig, ax = plt.subplots(1, 3, figsize=(14, 3.8))\n",
    "heat(ax[0], grid_mse, \"(a) CV MSE; bold = within one s.e. of the minimum\\nred square: minimum, yellow circle: one-s.e. rule\", within, i_best, (i_one, j_one))\n",
    "heat(ax[1], grid_train, \"(b) training MSE of the fold models\")\n",
    "for j, lam in enumerate(lambdas):\n",
    "    ax[2].errorbar(gammas, grid_mse[:, j], yerr=grid_se[:, j], marker=\"o\", ms=3, capsize=2, label=f\"$\\\\lambda={lam:g}$\")\n",
    "ax[2].axhline(sigma**2, color=GREY, ls=\":\", label=\"$\\\\sigma^2$\"); ax[2].axhline(y.var(), color=GREY, ls=\"--\", label=\"var($y$)\")\n",
    "ax[2].set_xscale(\"log\"); ax[2].set_yscale(\"log\"); ax[2].set_xlabel(\"$\\\\gamma$\"); ax[2].set_ylabel(\"CV MSE $\\\\pm$ s.e.\")\n",
    "ax[2].legend(fontsize=6, ncol=2); ax[2].grid(alpha=0.3); ax[2].set_title(\"(c) the same grid read along $\\\\gamma$\", fontsize=9)\n",
    "fig.tight_layout(); plt.show()"
   ]
