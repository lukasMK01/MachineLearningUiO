    "def fit_predict_poly(x_tr, y_tr, x_ev, degree=5):\n",
    "    \"\"\"Least squares on the Vandermonde matrix; returns the predictions at x_ev.\"\"\"\n",
    "    V = lambda z: np.vander(z, degree + 1, increasing=True)\n",
    "    theta = np.linalg.pinv(V(x_tr)) @ y_tr\n",
    "    return V(x_ev) @ theta\n",
    "\n",
    "\n",
    "def cv_estimate(x_data, y_data, k, rng, degree=5):\n",
    "    \"\"\"k-fold CV of fit_predict_poly: the mean fold MSE and its claimed standard error.\"\"\"\n",
    "    folds = np.array_split(rng.permutation(len(y_data)), k)\n",
    "    errs = []\n",
    "    for val in folds:\n",
    "        tr = np.setdiff1d(np.arange(len(y_data)), val)\n",
    "        errs.append(mse(y_data[val], fit_predict_poly(x_data[tr], y_data[tr], x_data[val], degree)))\n",
    "    errs = np.array(errs)\n",
    "    return errs.mean(), errs.std(ddof=1) / np.sqrt(k)\n",
    "\n",
    "\n",
    "ks = [2, 5, 10, 25, 100]\n",
    "n_rep = 200\n",
    "rng_rep = np.random.default_rng(2026)\n",
    "x_big = np.linspace(-1, 1, 20000)\n",
    "est = {kk: [] for kk in ks}; claimed = {kk: [] for kk in ks}; true_err = []\n",
    "for r in range(n_rep):\n",
    "    xr = rng_rep.uniform(-1, 1, n); yr = runge(xr) + rng_rep.normal(0, sigma, n)\n",
    "    y_big = runge(x_big) + rng_rep.normal(0, sigma, len(x_big))\n",
    "    true_err.append(mse(y_big, fit_predict_poly(xr, yr, x_big)))         # the procedure trained on all 100 points\n",
    "    for kk in ks:\n",
    "        m, s = cv_estimate(xr, yr, kk, rng_rep)\n",
    "        est[kk].append(m); claimed[kk].append(s)\n",
    "true_err = np.array(true_err)\n",
    "print(f\"true generalisation error of OLS degree 5 trained on 100 points, averaged over {n_rep} data sets: {true_err.mean():.5f}\")\n",
    "print(f\"{'k':>4s} {'training size':>14s} {'shared fraction':>16s} {'mean CV estimate':>17s} {'bias':>9s} {'sd across data sets':>20s} {'mean claimed s.e.':>18s}\")\n",
    "for kk in ks:\n",
    "    e = np.array(est[kk]); c = np.array(claimed[kk])\n",
    "    print(f\"{kk:4d} {n * (kk - 1) // kk:14d} {(kk - 2) / (kk - 1):16.3f} {e.mean():17.5f} {e.mean() - true_err.mean():9.5f} {e.std(ddof=1):20.5f} {c.mean():18.5f}\")\n",
    "\n",
    "fig, ax = plt.subplots(1, 2, figsize=(10, 3.4))\n",
    "ax[0].errorbar(ks, [np.mean(est[kk]) for kk in ks], yerr=[np.std(est[kk], ddof=1) for kk in ks], marker=\"o\", capsize=3, color=BLUE,\n",
    "               label=\"CV estimate: mean $\\\\pm$ sd over 200 data sets\")\n",
    "ax[0].axhline(true_err.mean(), color=RED, ls=\"--\", label=\"true error of the procedure on 100 points\")\n",
    "ax[0].set_xscale(\"log\"); ax[0].set_xlabel(\"$k$\"); ax[0].set_ylabel(\"MSE\"); ax[0].legend(fontsize=7); ax[0].grid(alpha=0.3)\n",
    "ax[0].set_title(\"(a) the bias shrinks with $k$; the spread does not\", fontsize=9)\n",
    "ax[1].plot(ks, [np.std(est[kk], ddof=1) for kk in ks], \"o-\", color=BLUE, label=\"real sd of the estimate (across data sets)\")\n",
    "ax[1].plot(ks, [np.mean(claimed[kk]) for kk in ks], \"s--\", color=RED, label=\"claimed $s/\\\\sqrt{k}$ (within one data set)\")\n",
    "ax[1].set_xscale(\"log\"); ax[1].set_yscale(\"log\"); ax[1].set_xlabel(\"$k$\"); ax[1].set_ylabel(\"standard deviation of the CV estimate\")\n",
    "ax[1].legend(fontsize=7); ax[1].grid(alpha=0.3); ax[1].set_title(\"(b) the claimed $s/\\\\sqrt{k}$ against the real spread\", fontsize=9)\n",
