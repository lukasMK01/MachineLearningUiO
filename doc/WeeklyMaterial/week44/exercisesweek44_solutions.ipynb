    "# ADDED BY COPILOT — Exercise 3: MNIST classifier, stratified CV, OOF predictions, and final test evaluation.\n",
    "from pathlib import Path\n",
    "from sklearn.metrics import accuracy_score, confusion_matrix\n",
    "\n",
    "class NeuralNetClassifier(ClassifierMixin, BaseEstimator):\n",
    "    def __init__(self, hidden=(64,), activation=\"relu\", gamma=0.1, lmbd=0.0,\n",
    "                 epochs=20, batch_size=100, seed=2026):\n",
    "        self.hidden = hidden\n",
    "        self.activation = activation\n",
    "        self.gamma = gamma\n",
    "        self.lmbd = lmbd\n",
    "        self.epochs = epochs\n",
    "        self.batch_size = batch_size\n",
    "        self.seed = seed\n",
    "\n",
    "    def fit(self, X, y):\n",
    "        self.classes_ = np.unique(y)\n",
    "        class_index = np.searchsorted(self.classes_, y)\n",
    "        Y = np.eye(len(self.classes_))[class_index]\n",
    "        sizes = [X.shape[1], *self.hidden, len(self.classes_)]\n",
    "        layers = create_layers(sizes, self.activation, np.random.default_rng(self.seed))\n",
    "        self.layers_, self.history_ = train(\n",
    "            X, Y, layers, self.activation, \"softmax\", gamma=self.gamma,\n",
    "            epochs=self.epochs, batch_size=self.batch_size, lmbd2=self.lmbd,\n",
    "            rng=np.random.default_rng(self.seed),\n",
    "        )\n",
    "        return self\n",
    "\n",
    "    def predict_proba(self, X):\n",
    "        return predict(X, self.layers_, self.activation, \"softmax\")\n",
    "\n",
    "    def predict(self, X):\n",
    "        return self.classes_[np.argmax(self.predict_proba(X), axis=1)]\n",
    "\n",
    "# Load the repository's local MNIST archive; these alternatives cover running\n",
    "# from either this notebook's folder or the repository root.\n",
    "mnist_candidates = [\n",
    "    Path(\"data/mnist.npz\"),\n",
    "    Path(\"../week43/data/mnist.npz\"),\n",
    "    Path(\"doc/WeeklyMaterial/week43/data/mnist.npz\"),\n",
    "]\n",
    "mnist_path = next((path for path in mnist_candidates if path.is_file()), None)\n",
    "if mnist_path is None:\n",
    "    raise FileNotFoundError(\"Could not find week43/data/mnist.npz from the notebook working directory.\")\n",
    "with np.load(mnist_path) as mnist_data:\n",
    "    X_train_full = mnist_data[\"x_train\"].reshape(len(mnist_data[\"x_train\"]), -1).astype(np.float32) / 255.0\n",
    "    y_train_full = mnist_data[\"y_train\"]\n",
    "    X_test_mnist = mnist_data[\"x_test\"].reshape(len(mnist_data[\"x_test\"]), -1).astype(np.float32) / 255.0\n",
    "    y_test_mnist = mnist_data[\"y_test\"]\n",
    "\n",
    "rng_mnist = np.random.default_rng(2026)\n",
    "subset_indices = np.concatenate([\n",
    "    rng_mnist.choice(np.flatnonzero(y_train_full == digit), 1000, replace=False)\n",
    "    for digit in range(10)\n",
    "])\n",
    "X_sub, y_sub = X_train_full[subset_indices], y_train_full[subset_indices]\n",
    "cv_strat = StratifiedKFold(n_splits=5, shuffle=True, random_state=2026)\n",
    "\n",
    "# Exercise 3a: grid search; standard errors correct sklearn's ddof=0 fold SD.\n",
    "hidden_grid = [(32,), (64,), (128,)]\n",
    "gamma_grid = [0.01, 0.03, 0.1]\n",
    "mnist_search = GridSearchCV(\n",
    "    NeuralNetClassifier(epochs=20, batch_size=100, seed=2026),\n",
    "    {\"hidden\": hidden_grid, \"gamma\": gamma_grid}, cv=cv_strat,\n",
    "    scoring=\"accuracy\", return_train_score=True, n_jobs=1,\n",
    ")\n",
    "mnist_search.fit(X_sub, y_sub)\n",
    "mnist_cv_results = mnist_search.cv_results_\n",
    "mnist_cv_mean = mnist_cv_results[\"mean_test_score\"].reshape(len(hidden_grid), len(gamma_grid))\n",
    "mnist_cv_se = mnist_cv_results[\"std_test_score\"].reshape(len(hidden_grid), len(gamma_grid)) / np.sqrt(cv_strat.get_n_splits() - 1)\n",
    "mnist_train_mean = mnist_cv_results[\"mean_train_score\"].reshape(len(hidden_grid), len(gamma_grid))\n",
    "mnist_best_flat = int(np.argmax(mnist_cv_mean))\n",
    "mnist_best_index = np.unravel_index(mnist_best_flat, mnist_cv_mean.shape)\n",
    "mnist_one_se_cutoff = mnist_cv_mean[mnist_best_index] - mnist_cv_se[mnist_best_index]\n",
    "mnist_within_one_se = mnist_cv_mean >= mnist_one_se_cutoff\n",
    "mnist_candidates = [(i, j) for i in range(len(hidden_grid))\n",
    "                    for j in range(len(gamma_grid)) if mnist_within_one_se[i, j]]\n",
    "smallest_width = min(hidden_grid[i][0] for i, _ in mnist_candidates)\n",
    "small_candidates = [(i, j) for i, j in mnist_candidates if hidden_grid[i][0] == smallest_width]\n",
    "chosen_i, chosen_j = max(small_candidates, key=lambda pair: (mnist_cv_mean[pair], -gamma_grid[pair[1]]))\n",
    "chosen_mnist_params = {\"hidden\": hidden_grid[chosen_i], \"gamma\": gamma_grid[chosen_j],\n",
    "                       \"epochs\": 20, \"batch_size\": 100, \"seed\": 2026}\n",
    "chosen_classifier = NeuralNetClassifier(**chosen_mnist_params)\n",
    "print(\"hidden | gamma | CV accuracy ± SE | training accuracy | within one SE\")\n",
    "for i, hidden in enumerate(hidden_grid):\n",
    "    for j, gamma in enumerate(gamma_grid):\n",
    "        print(f\"{hidden[0]:6d} | {gamma:5.2f} | {mnist_cv_mean[i, j]:.4f} ± \"\n",
    "              f\"{mnist_cv_se[i, j]:.4f} | {mnist_train_mean[i, j]:.4f} | \"\n",
    "              f\"{mnist_within_one_se[i, j]}\")\n",
    "print(\"Chosen by one-SE rule toward the smaller network:\", chosen_mnist_params)\n",
    "\n",
    "# Exercise 3b: every OOF prediction is made by a model that excluded that image.\n",
    "oof_predictions = cross_val_predict(\n",
    "    chosen_classifier, X_sub, y_sub, cv=cv_strat, method=\"predict\", n_jobs=1,\n",
    ")\n",
    "oof_confusion = confusion_matrix(y_sub, oof_predictions, labels=np.arange(10))\n",
    "subset_model = clone(chosen_classifier).fit(X_sub, y_sub)\n",
    "subset_test_predictions = subset_model.predict(X_test_mnist)\n",
    "subset_test_confusion = confusion_matrix(y_test_mnist, subset_test_predictions, labels=np.arange(10))\n",
    "print(\"OOF confusion matrix (training subset):\\n\", oof_confusion)\n",
    "print(\"Official-test confusion matrix for a model fit on the same subset (diagnostic only):\\n\",\n",
    "      subset_test_confusion)\n",
    "def top_confused_pairs(matrix, count=5):\n",
    "    off_diagonal = matrix.copy()\n",
    "    np.fill_diagonal(off_diagonal, 0)\n",
    "    flat = np.argsort(off_diagonal.ravel())[::-1]\n",
    "    return [(int(index // off_diagonal.shape[1]), int(index % off_diagonal.shape[1]),\n",
    "             int(off_diagonal.ravel()[index])) for index in flat[:count] if off_diagonal.ravel()[index] > 0]\n",
    "print(\"Most frequent OOF errors (true digit, predicted digit, count):\", top_confused_pairs(oof_confusion))\n",
    "print(\"Most frequent subset-model test errors:\", top_confused_pairs(subset_test_confusion))\n",
    "print(\"Use OOF predictions to describe cross-validated training performance; use the final full-training-set test matrix for the final test report.\")\n",
    "\n",
    "# Exercise 3c: learning curves at the specified training-set sizes.\n",
    "learning_sizes, learning_train_scores, learning_val_scores = learning_curve(\n",
    "    chosen_classifier, X_sub, y_sub, train_sizes=[1000, 2000, 5000, 8000],\n",
    "    cv=cv_strat, scoring=\"accuracy\", n_jobs=1,\n",
    ")\n",
    "learning_train_mean = learning_train_scores.mean(axis=1)\n",
    "learning_val_mean = learning_val_scores.mean(axis=1)\n",
    "learning_val_se = learning_val_scores.std(axis=1, ddof=1) / np.sqrt(cv_strat.get_n_splits())\n",
    "print(\"training size | training accuracy | validation accuracy ± SE\")\n",
    "for i, size in enumerate(learning_sizes):\n",
    "    print(f\"{size:12d} | {learning_train_mean[i]:.4f} | \"\n",
    "          f\"{learning_val_mean[i]:.4f} ± {learning_val_se[i]:.4f}\")\n",
    "print(\"training-minus-validation accuracy gap:\", np.round(learning_train_mean - learning_val_mean, 4))\n",
    "print(\"A shrinking gap as sample size grows suggests more data may help; a persistent gap suggests remaining model/optimization limitations.\")\n",
    "plt.figure(figsize=(7, 4))\n",
    "plt.plot(learning_sizes, learning_train_mean, marker=\"s\", label=\"training accuracy\")\n",
    "plt.errorbar(learning_sizes, learning_val_mean, yerr=learning_val_se,\n",
    "             marker=\"o\", label=\"validation accuracy ± SE\")\n",
    "plt.xlabel(\"Training examples per fold\")\n",
    "plt.ylabel(\"Accuracy\")\n",
    "plt.title(\"Exercise 3c: MNIST learning curve\")\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "# Exercise 3d: final configuration fit on all training images; report test once.\n",
    "final_mnist_model = clone(chosen_classifier).fit(X_train_full, y_train_full)\n",
    "final_test_predictions = final_mnist_model.predict(X_test_mnist)\n",
    "final_test_accuracy = accuracy_score(y_test_mnist, final_test_predictions)\n",
    "final_test_se = np.sqrt(final_test_accuracy * (1.0 - final_test_accuracy) / len(y_test_mnist))\n",
    "final_test_confusion = confusion_matrix(y_test_mnist, final_test_predictions, labels=np.arange(10))\n",
    "print(f\"Full-training-set test accuracy: {final_test_accuracy:.5f} ± {final_test_se:.5f} (binomial SE)\")\n",
    "print(\"Final test confusion matrix:\\n\", final_test_confusion)"
   ]
