    "project_arch_best = int(np.argmin(project_arch_mse))\n",
    "project_arch_within_se = project_arch_mse <= project_arch_mse[project_arch_best] + project_arch_se[project_arch_best]\n",
    "project_arch_eligible = np.flatnonzero(project_arch_within_se)\n",
    "project_arch_chosen = min(project_arch_eligible, key=lambda i: project_arch_params[i])\n",
