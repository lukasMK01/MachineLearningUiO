    "# ADDED BY COPILOT — Exercise 2c: compare width and depth at the 2b one-SE settings.\n",
    "gamma_1se = grid[\"gammas\"][oi]\n",
    "lambda_1se = grid[\"lambdas\"][oj]\n",
    "selected_epochs = 1000  # Exercise 2d may replace this using its validation curve.\n",
    "net_2c = clone(net).set_params(neuralnetregressor__gamma=gamma_1se,\n",
    "                               neuralnetregressor__lmbd=lambda_1se)\n",
    "hidden_values = [(5,), (10,), (25,), (50,), (100,)]\n",
    "train_scores, val_scores = validation_curve(\n",
    "    net_2c, X, y, param_name=\"neuralnetregressor__hidden\",\n",
    "    param_range=hidden_values, cv=cv, scoring=\"neg_mean_squared_error\",\n",
    "    #return_train_score=True,\n",
    ")\n",
    "train_mse_curve, val_mse_curve = -train_scores, -val_scores\n",
    "val_se_curve = val_mse_curve.std(axis=1, ddof=1) / np.sqrt(cv.get_n_splits())\n",
    "parameter_counts = [sum((a + 1) * b for a, b in zip([X.shape[1], *h], [*h, 1]))\n",
    "                    for h in hidden_values]\n",
    "plt.figure(figsize=(7, 4))\n",
    "plt.errorbar([h[0] for h in hidden_values], val_mse_curve.mean(axis=1),\n",
    "             yerr=val_se_curve, marker=\"o\", label=\"validation MSE ± SE\")\n",
    "plt.plot([h[0] for h in hidden_values], train_mse_curve.mean(axis=1),\n",
    "         marker=\"s\", label=\"training MSE\")\n",
    "plt.xlabel(\"Hidden units (one hidden layer)\")\n",
    "plt.ylabel(\"MSE\")\n",
    "plt.title(\"Exercise 2c: width at the 2b one-SE settings\")\n",
    "plt.legend()\n",
    "plt.show()\n",
    "print(\"width | parameters | CV MSE ± SE | training MSE\")\n",
    "for i, h in enumerate(hidden_values):\n",
    "    print(f\"{h[0]:5d} | {parameter_counts[i]:10d} | \"\n",
    "          f\"{val_mse_curve[i].mean():.5f} ± {val_se_curve[i]:.5f} | \"\n",
    "          f\"{train_mse_curve[i].mean():.5f}\")\n",
    "\n",
    "depth_values = [(25,), (25, 25), (25, 25, 25)]\n",
    "depth_search = GridSearchCV(\n",
    "    net_2c, {\"neuralnetregressor__hidden\": depth_values}, cv=cv,\n",
    "    scoring=\"neg_mean_squared_error\", return_train_score=True,\n",
    ")\n",
    "depth_search.fit(X, y)\n",
    "depth_results = depth_search.cv_results_\n",
    "depth_mse = -depth_results[\"mean_test_score\"]\n",
    "depth_se = depth_results[\"std_test_score\"] / np.sqrt(cv.get_n_splits() - 1)\n",
    "depth_train_mse = -depth_results[\"mean_train_score\"]\n",
    "print(\"\\ndepth | parameters | CV MSE ± SE | training MSE\")\n",
    "for i, h in enumerate(depth_values):\n",
    "    count = sum((a + 1) * b for a, b in zip([X.shape[1], *h], [*h, 1]))\n",
    "    print(f\"{len(h):5d} | {count:10d} | {depth_mse[i]:.5f} ± {depth_se[i]:.5f} | \"\n",
    "          f\"{depth_train_mse[i]:.5f} | hidden={h}\")\n",
    "\n",
    "# Also compare the one- and two-hidden-layer architectures named in Project 2.\n",
    "project_architectures = [(50,), (100,), (50, 50), (100, 100)]\n",
    "project_arch_search = GridSearchCV(\n",
    "    net_2c, {\"neuralnetregressor__hidden\": project_architectures}, cv=cv,\n",
    "    scoring=\"neg_mean_squared_error\", return_train_score=True,\n",
    ")\n",
    "project_arch_search.fit(X, y)\n",
    "project_arch_results = project_arch_search.cv_results_\n",
    "project_arch_mse = -project_arch_results[\"mean_test_score\"]\n",
    "project_arch_se = project_arch_results[\"std_test_score\"] / np.sqrt(cv.get_n_splits() - 1)\n",
    "project_arch_train = -project_arch_results[\"mean_train_score\"]\n",
    "project_arch_params = [sum((a + 1) * b for a, b in zip([X.shape[1], *h], [*h, 1]))\n",
