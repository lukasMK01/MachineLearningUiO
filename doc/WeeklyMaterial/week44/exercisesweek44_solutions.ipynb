   "source": [
    "class NeuralNetClassifier(BaseEstimator, ClassifierMixin):\n",
    "    def __init__(self, hidden=(64,), activation=\"relu\", gamma=0.1, lmbd=0.0, epochs=10, batch_size=100, seed=2026):\n",
    "        self.hidden = hidden\n",
    "        self.activation = activation\n",
    "        self.gamma = gamma\n",
    "        self.lmbd = lmbd\n",
    "        self.epochs = epochs\n",
    "        self.batch_size = batch_size\n",
    "        self.seed = seed\n",
    "\n",
    "    def fit(self, X, y):\n",
    "        self.classes_ = np.unique(y)\n",
    "        Y = one_hot(np.searchsorted(self.classes_, y), len(self.classes_))\n",
    "        layers = create_layers([X.shape[1], *self.hidden, len(self.classes_)], self.activation, np.random.default_rng(self.seed))\n",
    "        self.layers_, self.history_ = train(X, Y, layers, self.activation, \"softmax\", gamma=self.gamma, epochs=self.epochs,\n",
    "                                            batch_size=self.batch_size, lmbd2=self.lmbd, rng=np.random.default_rng(self.seed))\n",
    "        return self\n",
    "\n",
    "    def predict_proba(self, X):\n",
    "        return predict(X, self.layers_, self.activation, \"softmax\")\n",
    "\n",
    "    def predict(self, X):\n",
    "        return self.classes_[np.argmax(self.predict_proba(X), axis=1)]\n",
    "\n",
    "\n",
    "def confusion_matrix_multiclass(y_true, y_pred, n_classes):\n",
    "    \"\"\"C[i, j] = number of samples of true class i predicted as class j (week 43).\"\"\"\n",
    "    Cm = np.zeros((n_classes, n_classes), dtype=int)\n",
    "    np.add.at(Cm, (np.asarray(y_true).astype(int), np.asarray(y_pred).astype(int)), 1)\n",
    "    return Cm\n",
    "\n",
    "\n",
    "def per_class_from_confusion(Cm):\n",
    "    \"\"\"Precision and recall of every class from the K x K matrix (week 43).\"\"\"\n",
    "    tp = np.diag(Cm).astype(float)\n",
    "    return tp / np.maximum(Cm.sum(axis=0), 1), tp / np.maximum(Cm.sum(axis=1), 1)\n",
    "\n",
    "\n",
    "for path in (\"mnist.npz\", os.path.join(\"..\", \"BookPrograms\", \"chapter10_convolutional_networks\", \"mnist.npz\")):\n",
    "    if os.path.exists(path):\n",
    "        break\n",
    "data = np.load(path)\n",
    "x_train = data[\"x_train\"].reshape(len(data[\"x_train\"]), -1) / 255.0\n",
    "y_train = data[\"y_train\"].astype(int)\n",
    "x_test_m = data[\"x_test\"].reshape(len(data[\"x_test\"]), -1) / 255.0\n",
    "y_test_m = data[\"y_test\"].astype(int)\n",
    "rng = np.random.default_rng(2026)\n",
    "sub = np.concatenate([rng.choice(np.where(y_train == c)[0], 1000, replace=False) for c in range(10)])\n",
    "sub = rng.permutation(sub)                                  # random order, so that the first m of any fold are a mixture\n",
    "X_sub, y_sub = x_train[sub], y_train[sub]\n",
    "cv_strat = StratifiedKFold(n_splits=5, shuffle=True, random_state=2026)\n",
    "print(\"subset:\", X_sub.shape, \"class counts\", np.bincount(y_sub))\n",
    "print(\"per-digit counts in the validation folds:\", [np.bincount(y_sub[val]).tolist() for _, val in cv_strat.split(X_sub, y_sub)][0], \"(all five folds alike)\")\n",
    "# the wrapper against the week-41 loop, on the first 8000 of the subset\n",
