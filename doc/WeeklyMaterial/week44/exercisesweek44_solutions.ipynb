    "plt.ylabel(\"MSE\")\n",
    "plt.title(\"Exercise 2c: architecture complexity and generalisation\")\n",
    "plt.legend()\n",
    "plt.show()\n",
    "print(\"If training MSE keeps falling while CV MSE levels off or rises, that is overfitting.\")\n",
    "print(\"Architectures inside the one-SE band are not clearly distinguishable by these folds.\")"
